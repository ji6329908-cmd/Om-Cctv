      <img src="om-cctv-logo.png" alt="OM CCTV Logo">
      <div><span>OM</span> CCTV</div>
    </div>

    <nav>
      <a href="index.html">Home</a>
      <a href="services.html">Services</a>

      <div class="product-menu">
        <a href="products.html" class="active">Products ▾</a>

        <div class="mega-menu">
          <div class="mega-inner">
            <div class="cat-list">
              <button class="cat active" data-key="network">Network Camera</button>
              <button class="cat" data-key="nvr">Network Video Recorder (NVR)</button>
              <button class="cat" data-key="analog">Analog HD Camera</button>
              <button class="cat" data-key="dvr">Digital Video Recorder (DVR)</button>
              <button class="cat" data-key="online">Online Products</button>
              <button class="cat" data-key="illumax">Illumax</button>
              <button class="cat" data-key="guard">Guard+</button>
              <button class="cat" data-key="carkam">CarKam</button>
              <button class="cat" data-key="ptz">Speed Dome (PTZ)</button>
              <button class="cat" data-key="ezyhome">EzyHome</button>
              <button class="cat" data-key="router">4G Router</button>
              <button class="cat" data-key="doorphone">Video Door Phones</button>
              <button class="cat" data-key="attendance">Time &amp; Attendance</button>
              <button class="cat" data-key="mobile">Mobile Surveillance</button>
            </div>

            <div class="sub-area">
              <h3 id="megaTitle">Sub Categories</h3>
              <div id="megaItems" class="sub-grid"></div>
            </div>
          </div>
        </div>
      </div>

      <a href="rate.html">Rate</a>
      <a href="packages.html">Packages</a>
      <a href="customer-request.html">Customer Request</a>
      <a href="customer-support.html">Customer Support</a>
      <a href="contact.html">Contact</a>
    </nav>
  </div>
</header>

<main>
<section class="products-panel">
  <div class="mega-inner">
    <div class="cat-list">
      <button class="cat active" data-key="network">Network Camera</button>
      <button class="cat" data-key="nvr">Network Video Recorder (NVR)</button>
      <button class="cat" data-key="analog">Analog HD Camera</button>
      <button class="cat" data-key="dvr">Digital Video Recorder (DVR)</button>
      <button class="cat" data-key="online">Online Products</button>
      <button class="cat" data-key="illumax">Illumax</button>
      <button class="cat" data-key="guard">Guard+</button>
      <button class="cat" data-key="carkam">CarKam</button>
      <button class="cat" data-key="ptz">Speed Dome (PTZ)</button>
      <button class="cat" data-key="ezyhome">EzyHome</button>
      <button class="cat" data-key="router">4G Router</button>
      <button class="cat" data-key="doorphone">Video Door Phones</button>
      <button class="cat" data-key="attendance">Time &amp; Attendance</button>
      <button class="cat" data-key="mobile">Mobile Surveillance</button>
    </div>
    <div class="sub-area">
      <h3 id="pageTitle">Sub Categories</h3>
      <div id="pageItems" class="sub-grid"></div>
    </div>
  </div>
</section>
