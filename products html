<footer>
  © 2026 OM CCTV Camera Repairing • Daurala, Meerut • CCTV Installation, Repairing &amp; Service
</footer>

<script>
const menuData = {
  network: ["2 MP","4 MP","5 MP","6 MP","8 MP"],
  nvr: ["4 Ch.","8 Ch.","16 Ch.","32 Ch.","64 Ch.","128 Ch."],
  analog: ["2.4 MP","5 MP"],
  dvr: ["4 Ch.","8 Ch.","16 Ch.","32 Ch."],
  online: ["Analog Wired Kit"],
  illumax: ["Network","Analog"],
  guard: ["Guard+"],
  carkam: ["CarKam"],
  ptz: ["Speed Dome (PTZ)"],
  ezyhome: ["EzyHome"],
  router: ["4G Router"],
  doorphone: ["Video Door Phones"],
  attendance: ["Time & Attendance"],
  mobile: ["Mobile Surveillance"]
};

const cats = document.querySelectorAll(".cat");
const items = document.getElementById("megaItems");
const pageItems = document.getElementById("pageItems");
const pageTitle = document.getElementById("pageTitle");

function showMega(key, clickedCat) {
  cats.forEach(c => c.classList.remove("active"));
  if (clickedCat) clickedCat.classList.add("active");

  const markup = menuData[key].map(item =>
    `<a href="rate.html" class="sub-item">› ${item}</a>`
  ).join("");
  if(items) items.innerHTML = markup;
  if(pageItems) pageItems.innerHTML = markup;
  if(pageTitle) pageTitle.textContent = key === "network" ? "Sub Categories" : "Sub Categories";
}

cats.forEach(cat => {
  cat.addEventListener("mouseenter", () => showMega(cat.dataset.key, cat));
  cat.addEventListener("click", () => showMega(cat.dataset.key, cat));
});

showMega("network", document.querySelector(".cat.active"));
</script>

</body>
